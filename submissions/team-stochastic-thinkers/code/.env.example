TWILIO_ACCOUNT_SID=            # leave blank to run in simulated-SMS mode (codes/pings printed to the server log)
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1...
TWILIO_VERIFY_SERVICE_SID=     # optional: Twilio Verify service (VA…) for sign-in codes; best delivery to Indian numbers
TWILIO_VALIDATE_SIGNATURE=0    # 1 to verify X-Twilio-Signature on the inbound webhook (needs PUBLIC_BASE_URL); ops identity bypasses it
OLLAMA_URL=http://localhost:11434   # README §12 default; http://127.0.0.1:11434 skips an IPv6-first "localhost" resolve inside the 4 s budget
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=4000
SESSION_SECRET=                # openssl rand -hex 32 (blank = random per process, sessions die on restart)
OPS_PASSWORD=resq-ops
SEED_CENTER_LAT=8.913          # set to the venue's real coordinates before `npm run seed` (see docs/CONTRACTS.md §11.2)
SEED_CENTER_LNG=76.635
SEED_ON_BOOT=1
STORE=memory
MONGODB_URI=mongodb://127.0.0.1:27017   # registered users, authorities, locations, zones, audit log (blank = .data/accounts.json)
MONGODB_DB=resq
PUBLIC_BASE_URL=               # https://<cloudflared>.trycloudflare.com — used in SMS links and signature checks
RESQ_WAVE_WINDOW_MS=30000
RESQ_DEV_ORIGINS=              # comma-separated extra dev hostnames for allowedDevOrigins, e.g. 192.168.1.20 for the LAN fallback
RESQ_DATA_FILE=                # accounts file (no DB): blank = .data/accounts.json, "off" = memory only
RESQ_SHOW_OTP_ON_SCREEN=0      # 1 = show sign-in codes on screen when Twilio is not set up (offline demo only)

# ── AI job scoping and receipt reading (local, via Ollama) ────────────────────────────────────────────────────
OLLAMA_SCOPE_MODEL=llama3.1          # job scoping; falls back to OLLAMA_MODEL when not installed
OLLAMA_SCOPE_TIMEOUT_MS=45000
RESQ_RECEIPT_MODEL=                  # blank = try llama3.2-vision:11b, then qwen2.5vl:3b (moondream
                                     # is excluded: measured misreading every line of a test bill as Rs 4.17)
RESQ_RECEIPT_TIMEOUT_MS=60000        # vision models are slower than text; a receipt takes 10-40 s
RESQ_TRANSLATE_MODEL=gemma2:2b       # Malayalam -> English for the mic, ~1 s. Does NOT inherit the scope model:
                                     # llama3.1 needs 4.9 GB and times out on an 8 GB laptop. No small local model
                                     # translates reliably BETWEEN two Indian languages - see lib/translate.ts.
RESQ_TRANSLATE_TIMEOUT_MS=60000

# ── Payments (Razorpay) ───────────────────────────────────────────────────────────────────────────────────────
# Blank keys = demo mode: the bill, the split and the wallet credit all work, but no money moves and the UI says so.
RAZORPAY_KEY_ID=                     # rzp_test_… from dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=             # Settings → Webhooks; the secret you choose when adding the endpoint
RESQ_COMMISSION_PCT=10               # platform cut, charged on the work only — never on parts the worker bought

# ── Indian-language speech and translation (Sarvam AI) ────────────────────────────────────────────────────────
# The one part of ResQ that is not local, and the only one that works: no model that fits an 8 GB laptop can
# translate between two Indian languages (llama3.1 times out; qwen2.5:3b echoes the input back). Sarvam does
# Malayalam speech -> English text in ~0.8 s, and every language pair the app offers. Job scoping and receipt
# reading still run locally on Ollama. Blank = voice input is disabled and translation falls back to Ollama.
SARVAM_API_KEY=                      # dashboard.sarvam.ai -> API keys
SARVAM_TIMEOUT_MS=20000
