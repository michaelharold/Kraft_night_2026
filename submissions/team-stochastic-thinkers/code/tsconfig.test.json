{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node10",
    "noEmit": false,
    "incremental": false,
    "outDir": ".test-dist",
    "rootDir": ".",
    "jsx": "react-jsx",
    "plugins": [],
    "types": ["node"],
    "allowJs": false
  },
  "include": ["lib/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", ".next", ".test-dist"]
}
